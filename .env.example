# r_flix is configured on its Admin page. Only these bootstrap options live outside the database.
# Copy to .env (never commit it) and pass with `env_file:` in docker-compose.yml, or export them.

# PORT=8080
# RFLIX_DATA=./data                  # where rflix.db and secret.key are stored (/data in Docker)
# RFLIX_SECRET=                      # optional: key for encrypting stored Jellyfin credentials
# RFLIX_TRUST_PROXY=1                # set when behind a reverse proxy
# RFLIX_SETUP_CODE=                  # optional fixed first-run code (otherwise a random one is logged)

# --- Optional one-time import (upgrading from the config-file version) -------------------
# If the database has no servers yet, JELLYFIN_<n>_* variables (and config/config.json) are
# imported once at start-up, then ignored: edit servers on the Admin page afterwards.
# JELLYFIN_1_NAME=Living Room
# JELLYFIN_1_URL=http://192.168.1.10:8096
# JELLYFIN_1_API_KEY=
# JELLYFIN_2_URL=http://192.168.1.20:8096
# JELLYFIN_2_USERNAME=
# JELLYFIN_2_PASSWORD=
