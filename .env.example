# Optional: configure servers with environment variables instead of config/config.json.
# Variables override the same-numbered server in the file. Server order = priority.
# Never commit your real .env.

JELLYFIN_1_NAME=Living Room
JELLYFIN_1_URL=http://192.168.1.10:8096
JELLYFIN_1_API_KEY=

JELLYFIN_2_NAME=Basement NAS
JELLYFIN_2_URL=http://192.168.1.20:8096
# Use a login instead of an API key:
JELLYFIN_2_USERNAME=
JELLYFIN_2_PASSWORD=

# PORT=8080
# RFLIX_CACHE_TTL=300
# RFLIX_CONFIG=/path/to/config.json
